      "capability_id": "build.candidate.v1",
      "version": "1.0.0",
      "status": "planned",
      "description": "候选构建尚未实现；不得调用，不能借此运行任意 shell。",
      "effect": "build",
      "executor_ref": null,
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
