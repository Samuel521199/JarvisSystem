      "criteria": [
        {
          "id": "c1",
          "text": "每个练习日总时长不超过20分钟"
        },
        {
          "id": "c2",
          "text": "包含休息日且未知英语水平明确标为假设"
        }
      ],
      "decision": "ready_for_owner_review",
      "goal": "为白天工作的成年人设计七天英语练习安排，每天只有20分钟，并留出休息日。不假定他的英语水平。",
      "kind": "jarvis.team-report",
      "limits": "模型审阅意见不等于事实核验或业务验收；没有自动应用方案、执行工具或更新记忆。",
      "proposal": {
        "assumptions": [
          "待核实使用者的真实英语水平（零基础、初级、中级或高级），目前方案假定内容难度可通过素材自由适配",
          "待核实学习者偏好的练习时间段（如晨起、午休或晚间睡前），假定其每天能连续抽出完整的20分钟专注时间"
        ],
        "risks": [
          "若初始选材难度过高或过低，可能导致前两天体验不佳而丧失持续动力",
          "每天20分钟时长较短，若缺乏长期连续坚持，短期内口语或听力突破可能不明显"
        ],
        "steps": [
          {
            "detail": "耗时20分钟。选择一个包含多难度梯度的英语播客或分级短文，花10分钟试听或试读以评估当前舒适区；剩余10分钟记录5个生词或句型，确定后续练习的起点难度。",
            "id": "s1",
            "title": "第1天：个人水平摸底与基础听读"
          },
          {
            "detail": "耗时20分钟。基于第1天确定的难度级别，挑选一段1-2分钟的简短音频。先听2遍熟悉节奏（5分钟），随后进行句子跟读与模仿练习（15分钟），提升发音和语感。",
            "id": "s2",
            "title": "第2天：职场/日常影子跟读训练"
          },
          {
            "detail": "休息日，不作强制训练安排。完全放松，或可选择在通勤、休闲时被动聆听喜欢的英文歌曲/背景广播，不计入正式练习。",
            "id": "s3",
            "title": "第3天：休息与无压力输入"
          },
          {
            "detail": "耗时20分钟。回顾第1-2天学到的表达（5分钟），选择3个重点词汇或句型，尝试结合自己的实际生活或工作场景造句，口头表达或写在便签上（15分钟）。",
            "id": "s4",
            "title": "第4天：核心词汇与句型微输出"
          },
          {
            "detail": "耗时20分钟。选定一个极简日常话题（如介绍今天的工作或一顿饭），前5分钟列出关键词，后15分钟开启手机录音，尝试用英语自述并回听，找出停顿和卡顿点。",
            "id": "s5",
            "title": "第5天：即兴口语碎片表达"
          },
          {
            "detail": "耗时20分钟。选择一篇契合自身水平的100-200字微短文，通读了解大意（5分钟），重点分析1-2个复杂句子结构及用法（15分钟）。",
            "id": "s6",
            "title": "第6天：短文精读与语篇速览"
          },
          {
            "detail": "休息日。安排15-20分钟彻底放松身心；若有余力，花最后5分钟翻看本周记录便签，简要总结哪类练习最适应、难度是否需要调整，为下周做准备。",
            "id": "s7",
            "title": "第7天：全面休息与周度复盘"
          }
        ],
        "summary": "为成年上班族定制的7天微习惯英语练习计划，严格限制单日20分钟内，包含2天休息日，内容采用自适应难度的模块化设计。"
      },
      "review": {
        "criteria": [
          {
            "criterion_id": "c1",
            "reason": "所有具体练习日（第1、2、4、5、6天）以及包含复盘的第7天的任务总时长均被严格控制在20分钟以内。",
            "status": "addressed"
          },
          {
            "criterion_id": "c2",
            "reason": "方案在第3天和第7天安排了休息日，并在assumptions中明确列出了“待核实使用者的真实英语水平”作为重要假设。",
            "status": "addressed"
          }
        ],
        "findings": [
          {
            "issue": "第7天被定义为休息日，但依然安排了5分钟的复盘任务。尽管总时间未超过限制，但可能影响休息日的完全放松体验。",
            "severity": "concern",
            "step_id": "s7"
          }
        ],
        "summary": "方案整体设计合理，严格遵守了时间限制并包含了休息日，同时在前提假设中明确了对未知英语水平的处理。发现部分休息日仍有微小的复盘任务，可进一步优化以确保完全放松。",
        "verdict": "ready_for_owner_review"
      },
