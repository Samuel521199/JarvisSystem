{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:owner-recovery:1.1.0",
  "title": "Explicit local migration of legacy stopped state; no authentication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "node_id",
    "security_epoch",
    "incident_ids",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "kind": {
      "const": "jarvis.local-maintenance"
    },
    "node_id": {
      "type": "string",
      "format": "uuid"
    },
    "security_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "incident_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^incident_[0-9a-f]{32}$"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    }
  }
}
