{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis native skill catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source",
          "version",
          "default_mode",
          "use_when",
          "do_not_use_when",
          "workflow",
          "guide",
          "positive_examples",
          "negative_examples"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{1,100}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "default_mode": {
            "enum": [
              "auto",
              "manual",
              "disabled"
            ]
          },
          "use_when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "do_not_use_when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "workflow": {
            "enum": [
              "internal",
              "guidance",
              "anatomy",
              "deferred",
              "rea",
              "game"
            ]
          },
          "guide": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          },
          "positive_examples": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "negative_examples": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "presentation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "icon",
              "summary",
              "output",
              "requirements",
              "kind",
              "components"
            ],
            "properties": {
              "icon": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "output": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "requirements": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "category": {
                "enum": [
                  "engineering",
                  "planning",
                  "learning",
                  "visual"
                ]
              },
              "kind": {
                "enum": [
                  "combined",
                  "independent"
                ]
              },
              "components": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            }
          },
          "evaluation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "guide_sha256",
              "summary",
              "scope"
            ],
            "properties": {
              "guide_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        }
      }
    },
    "inventory": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "disposition",
          "capability",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "disposition": {
            "enum": [
              "active",
              "merged",
              "internal",
              "removed",
              "unavailable"
            ]
          },
          "capability": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
