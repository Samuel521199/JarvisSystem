{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicitly scoped browser task v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "url", "goal", "allowed_origins", "targets", "success", "max_steps", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "url": {"type": "string", "minLength": 1, "maxLength": 2048},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "allowed_origins": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "maxLength": 256}},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 20},
    "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 600},
    "targets": {"type": "array", "minItems": 1, "maxItems": 30, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "name", "actions", "values"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "role": {"enum": ["button", "link", "textbox", "combobox", "checkbox", "radio"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 150},
        "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["click", "fill", "select", "check"]}},
        "values": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"oneOf": [{"type": "string", "maxLength": 2000}, {"type": "boolean"}]}}
      }
    }},
    "success": {"type": "object", "additionalProperties": false, "required": ["role", "text"],
      "properties": {"role": {"enum": ["status", "alert", "heading"]}, "text": {"type": "string", "minLength": 1, "maxLength": 1000}}}
  }
}
