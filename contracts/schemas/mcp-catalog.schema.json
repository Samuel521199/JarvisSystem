{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "reviewed_at", "servers", "combinations", "excluded"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewed_at": {"type": "string"},
    "servers": {"type": "array", "minItems": 1, "maxItems": 50, "items": {
      "type": "object",
      "required": ["id", "name", "category", "icon", "publisher", "source_type", "source_url", "summary", "use_when", "do_not_use_when", "requirements", "cost", "skills", "template", "reviewed_at", "review_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,60}$"},
        "name": {"type": "string", "minLength": 1},
        "category": {"enum": ["development", "browser", "research", "files", "creative"]},
        "icon": {"enum": ["book", "github", "browser", "search", "compass", "flame", "document", "folder", "branch", "cube"]},
        "publisher": {"type": "string"},
        "source_type": {"enum": ["vendor", "reference", "community"]},
        "source_url": {"type": "string", "pattern": "^https://github\\.com/"},
        "summary": {"type": "string", "minLength": 1},
        "use_when": {"type": "string", "minLength": 1},
        "do_not_use_when": {"type": "string", "minLength": 1},
        "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cost": {"type": "string"},
        "skills": {"type": "array", "items": {"type": "string"}},
        "template": {"type": "object", "required": ["transport"], "properties": {"transport": {"enum": ["stdio", "streamable-http"]}}},
        "reviewed_at": {"type": "string"},
        "review_status": {"enum": ["source_reviewed", "source_page_reviewed"]}
      }
    }},
    "combinations": {"type": "array"},
    "excluded": {"type": "array"}
  }
}
