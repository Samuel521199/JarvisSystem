{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/artifact/1.0.0",
  "title": "Jarvis artifact v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:\\u0000]+$",
      "description": "Normalized relative path. Runtime must additionally resolve links and enforce its allowed root."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "report",
        "inventory",
        "code",
        "package",
        "other"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "privacy": {
      "enum": [
        "local_only",
        "selected_nodes",
        "community"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
        }
      },
      "required": [
        "module_id",
        "version"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "task_id",
    "action_id",
    "path",
    "digest",
    "media_type",
    "size_bytes"
  ]
}
