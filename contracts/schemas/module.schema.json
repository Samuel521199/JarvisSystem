{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/module/1.0.0",
  "title": "Jarvis module v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "status": {
      "enum": [
        "planned",
        "candidate",
        "installed",
        "disabled"
      ]
    },
    "artifact_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "protocol_range": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provides",
        "requires",
        "protocol_range"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "migrate_from": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "migrate_from"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint_supported": {
          "type": "boolean"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "checkpoint_supported",
        "concurrency"
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "network_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "device_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "filesystem_scopes",
        "network_scopes",
        "device_scopes"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "memory_mb",
        "timeout_seconds"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluation_suite": {
          "type": "string",
          "minLength": 1
        },
        "rollback_strategy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evaluation_suite",
        "rollback_strategy"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "artifact_digest",
    "signature_ref",
    "platforms",
    "runtime",
    "entrypoint",
    "contracts",
    "state",
    "execution",
    "permissions",
    "resources",
    "release"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "installed"
          }
        }
      },
      "then": {
        "properties": {
          "artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
