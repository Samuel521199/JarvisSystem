{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/task/1.0.0",
  "title": "Jarvis task v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "goal_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "enum": [
        "local",
        "community"
      ]
    },
    "owner_node_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "owner_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "workflow_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "planning_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_schema": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost_units": {
          "type": "number",
          "minimum": 0
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_cost_units",
        "max_runtime_seconds",
        "max_attempts"
      ]
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "cancellation_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "CREATED",
        "PLANNED",
        "READY",
        "RUNNING",
        "WAITING",
        "PAUSED",
        "VERIFYING",
        "SUCCEEDED",
        "UNKNOWN",
        "FAILED",
        "CANCELLING",
        "CANCELLED"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "result_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "goal_id",
    "parent_task_id",
    "scope",
    "owner_node_id",
    "owner_epoch",
    "workflow_version",
    "skill_version",
    "planning_policy_version",
    "authorization_ref",
    "checkpoint_schema",
    "budget",
    "required_capabilities",
    "cancellation_ref",
    "status"
  ]
}
