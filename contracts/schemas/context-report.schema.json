{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/context-report/1.0.0",
  "title": "Jarvis request-local chat context report v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "strategy": {
      "const": "recent-whole-turns-v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "note_applied": {
      "type": "boolean"
    },
    "note_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8192
    },
    "required_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "total_text_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "max_text_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "token_count": {
      "type": "null"
    },
    "summarized": {
      "const": false
    },
    "kept_indexes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999
      }
    }
  },
  "required": [
    "schema_version",
    "strategy",
    "revision",
    "provider",
    "model",
    "note_applied",
    "note_bytes",
    "required_bytes",
    "total_text_bytes",
    "max_text_bytes",
    "token_count",
    "summarized",
    "kept_indexes"
  ]
}
