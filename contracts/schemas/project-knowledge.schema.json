{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/project-knowledge.schema.json",
  "title": "Explicit project sources v1",
  "$ref": "#/$defs/write",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[a-f0-9]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "path",
        "providers"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "providers": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "not": {
              "enum": [
                "auto",
                "local"
              ]
            }
          }
        }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "document"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "document": {
          "$ref": "#/$defs/document"
        }
      }
    },
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "project_id"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "project_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "project_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]+$"
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "history": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/references"
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "reference",
        "path",
        "title",
        "start_line",
        "end_line"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^P[1-6]$",
          "maxLength": 2
        },
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "project_name": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "query"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "reference",
        "start_line",
        "end_line"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_ids",
        "query",
        "memory_enabled"
      ],
      "properties": {
        "project_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "project_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "memory_enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
